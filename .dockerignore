# The API image needs pyproject.toml and overshare/ and nothing else. Without
# this the build context is the whole repository — around 570MB, most of it
# web/node_modules — uploaded on every deploy to produce an image that uses
# none of it.

.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
*.egg-info

# The frontend is a separate image built from web/, which has its own
# .dockerignore.
web

# Local scan databases must never be baked into an image.
*.db
*.db-wal
*.db-shm

.env
.env.*
!.env.example

tests
testdata
marketing
.github
*.md
!README.md
