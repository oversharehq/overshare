# Base URL of the LeakScan API, without the /v1 suffix.
# Read at server start, so the same image works in every environment.
# When unset, /api/v1 falls through to the built-in mock and the UI shows a
# "sample data" banner. In a production build the mock refuses to serve at all.
LEAKSCAN_API_URL=http://localhost:8000

# Public origin of this site. Baked in at BUILD time because it is used by
# sitemap.xml, robots.txt and canonical URLs, all of which are prerendered.
# Pass it as a build arg to Docker, not a runtime env var.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
